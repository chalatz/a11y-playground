<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title }} - a11y playground</title>

	<link rel="stylesheet" href="https://cdn.simplecss.org/simple.min.css">
	<style>
    	.visually-hidden {
            border: 0;
            clip-path: inset(50%);
            height: 1px;
            margin: 0;
            overflow: hidden;
            position: absolute;
            white-space: nowrap;
            width: 1px;
    	}
	</style>
</head>
<body>

    {{ content }}

</body>
</html>
